    - '// @input float labelSeconds = 3 {"hint":"Seconds the full floor labels stay up after any change", "widget":"slider", "min":0.5, "max":10, "step":0.5}'
    - '// @input vec3 ghostColor = "{0.431,0.545,0.659}" {"hint":"Ghost colour: dim, solid, unlit blue-grey (#6E8BA8); the shoulder line and crown are drawn a little brighter", "widget":"color"}'
    - '// @input float tintOpacity = 0.35 {"hint":"Opacity of the coloured floor tint under the crowd", "widget":"slider", "min":0.05, "max":1, "step":0.05}'
    - "// @input float eyeHeightCm = 160 {\"hint\":\"Eye height assumed for the virtual floor when the real floor isn't found (cm)\", \"widget\":\"slider\", \"min\":100, \"max\":200, \"step\":1}"

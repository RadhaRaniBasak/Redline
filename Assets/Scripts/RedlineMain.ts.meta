    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float clearRadiusCm = 60 {"hint":"Radius of the clear circle kept around the user (cm); applies to bodies only", "widget":"slider", "min":20, "max":150, "step":5}'

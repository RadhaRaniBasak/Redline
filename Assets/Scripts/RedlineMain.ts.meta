  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">RedlineMain – zone, ghost crowd density, redline cues</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject zoneRoot {"hint":"Zone root; it is placed on the floor at start and the outline, tint, square, handles and crowd are built under it"}'
    - '// @input SceneObject arrowRoot {"hint":"Root of the floor arrow that points back to the zone"}'
    - "// @input SceneObject virtualFloorRoot {\"hint\":\"Stand-in floor grid, shown only when the real floor isn't found\"}"
    - '// @input AssignableType_1 clipboard {"hint":"Clipboard panel: density slider + Done / Edit zone"}'
